# Copy to .env and fill in. Never commit .env.
# Do not create .env.local: it overrides .env, and even empty keys there blank out real values.

# Public site URL (canonical URLs, sitemap, Open Graph), e.g. http://localhost:3000
NEXT_PUBLIC_SITE_URL=
# "true" only on the production deployment; anything else = noindex
SITE_INDEXABLE=

# MongoDB Atlas (Payload CMS). Alternatively set a full DATABASE_URL instead of these parts.
MONGODB_USER=
MONGODB_PASSWORD=
# SRV host (cluster0.xxxx.mongodb.net). If SRV DNS fails locally, also set MONGODB_HOSTS (comma list)
# and MONGODB_REPLICA_SET to use the standard format instead.
MONGODB_HOST=
MONGODB_HOSTS=
MONGODB_REPLICA_SET=
MONGODB_DB=

# Long random string that signs admin logins:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# Outgoing email (enquiry confirmations). Leave SMTP_HOST empty to only log mails to the console.
# Gmail: smtp.gmail.com, port 465, the Gmail address as user, and a Google "App password" as pass.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# Sender shown to the customer; with Gmail it must be the same Gmail address.
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=
